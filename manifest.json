{
  "manifest_version": "0.3",
  "name": "word-mcp-semantic",
  "version": "2.0.0",
  "description": "A semantic OOXML engine for Word documents over MCP: locator-based reading and editing that refuses rather than approximates, tracked changes, comments, document audit and comparison, plus live editing while the document is open in Word. 137 tools.",
  "author": {
    "name": "Philippe Lê",
    "url": "https://github.com/LePhilippeDucTai"
  },
  "repository": {
    "url": "https://github.com/LePhilippeDucTai/word-mcp-semantic",
    "type": "git"
  },
  "license": "MIT",
  "server": {
    "type": "python",
    "entry_point": "word_mcp_server.py",
    "mcp_config": {
      "command": "uvx",
      "args": ["word-mcp-semantic"],
      "env": {
        "MCP_AUTHOR": "Author",
        "MCP_AUTHOR_INITIALS": ""
      }
    }
  },
  "keywords": ["word", "docx", "microsoft-word", "document", "ooxml", "com-automation", "tracked-changes", "live-editing"]
}
