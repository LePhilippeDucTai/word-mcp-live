    office:version="1.2" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:styles>
  <style:style style:name="Standard" style:family="paragraph" style:class="text"/>
 </office:styles>
 <office:body>
  <office:text>
   <text:p text:style-name="Standard">A paragraph with <text:bookmark-start text:name="MyBookmark"/>a bookmarked phrase<text:bookmark-end text:name="MyBookmark"/> inside it.</text:p>
   <text:p text:style-name="Standard">This sentence has a footnote<text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p text:style-name="Standard">Footnote body text.</text:p></text:note-body></text:note> attached to it.</text:p>
   <text:p text:style-name="Standard">Current page is <text:page-number text:select-page="current">1</text:page-number> of <text:page-count>1</text:page-count>.</text:p>
  </office:text>
